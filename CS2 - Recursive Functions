"""
    Description: Calculates the factorial of a number recursively.
    Args:
        The number being multiplied down to 1.
    Return:
        The factorial of "n".
    """
def factorial(n):

    if n == 0 or n == 1:
        return 1

    return n * factorial(n - 1)


"""
    Description: Adds all numbers from "n" down to 1 recursively.
    Args:
        The number to start the summation from.
    Return:
        The sum of all numbers from 1 to "n".
    """
def summation(n):



    if n == 1:
        return 1

    return n + summation(n - 1)


"""
    Description: Calculates a base raised to an exponent recursively.
    Args:
        The number being multiplied, The power the base is raised to.
    Return:
        The result of "base" raised to exponent.
    """
def power(base, exponent):

    if exponent == 0:
        return 1

    return base * power(base, exponent - 1)


"""
    Description: Finds the "n"th Fibonacci number recursively.
    Args:
        The position in the Fibonacci sequence.
    Return:
        The Fibonacci number at position "n".
    """
def fibonacci(n):

    if n == 0:
        return 0

    if n == 1:
        return 1

    return fibonacci(n - 1) + fibonacci(n - 2)


"""
    Description: Adds each digit in a number recursively.
    Args:
        The number whose digits are being added.
    Return:
        The sum of the digits.
    """
def sum_digits(n):

    if n < 10:
        return n

    return (n % 10) + sum_digits(n // 10)


"""
    Description: Multiplies each digit in a number recursively.
    Args:
        The number whose digits are being multiplied.
    Return:
        The product of the digits.
    """
def product_digits(n):

    if n < 10:
        return n

    return (n % 10) * product_digits(n // 10)


"""
    Description: Multiplies two whole numbers using continuos addition recursively.
    Args:
        "a": The number being added repeatedly.
        "b": The number of times "a" is added.
    Return:
        int: The product of "a" and "b".
    """
def product_numbers(a, b):

    if b == 0:
        return 0

    return a + product_numbers(a, b - 1)


"""
    Description: Adds all numbers from start to end recursively.
    Args:
        The beginning number of the range, The ending number of the range.
    Return:
        The sum of all numbers in the range.
    """
def range_sum(start, end):

    if start == end:
        return start

    return start + range_sum(start + 1, end)


"""
    Description: Reverses the digits of a number recursively.
    Args:
        The original number being reversed, The reversed number being built during recursion.
    Return:
        The reversed number.
    """
def reverse_number(n, reversed_num=0):

    if n == 0:
        return reversed_num

    return reverse_number(
        n // 10,
        reversed_num * 10 + (n % 10)
    )

"""
    Description: Displays a menu that lets the user select the recursive algorithm to run.
    Args:
        None
    Return:
        None
    """
