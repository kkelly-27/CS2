        print("5. Sum of a Number's Digits")
        print("6. Product of a Number's Digits")
        print("7. Product of Two Whole Numbers")
        print("8. Sum of Numbers in a Range")
        print("9. Reverse the Digits in a Number")
        print("10. Exit")

        select = input("\nEnter Menu Selection (1-10): ")

        if select == "1":

            number = int(input("Enter a number: "))
            print("Factorial:", factorial(number))

        elif select == "2":

            number = int(input("Enter a number: "))
            print("Summation:", summation(number))

        elif select == "3":

            base = int(input("Enter the base: "))
            exponent = int(input("Enter the exponent: "))
            print("Power:", power(base, exponent))

        elif select == "4":

            number = int(input("Enter a number: "))
            print("Fibonacci:", fibonacci(number))

        elif select == "5":

            number = int(input("Enter a number: "))
            print("Sum of Digits:", sum_digits(number))

        elif select == "6":

            number = int(input("Enter a number: "))
            print("Product of Digits:", product_digits(number))

        elif select == "7":

            num1 = int(input("Enter the first number: "))
            num2 = int(input("Enter the second number: "))
            print("Product:", product_numbers(num1, num2))

        elif select == "8":

            start = int(input("Enter the starting number: "))
            end = int(input("Enter the ending number: "))
            print("Range Sum:", range_sum(start, end))

        elif select == "9":

            number = int(input("Enter a number: "))
            print("Reversed Number:", reverse_number(number))

        elif select == "10":

            print("PROGRAM TERMINATED.")
            break

        else:

            print("Invalid Selection.")


main() 
